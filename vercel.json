{
  "cleanUrls": true,
  "rewrites": [{ "source": "/dashboard", "destination": "/api/dashboard-page" }],
  "redirects": [
    { "source": "/dashboard/", "destination": "/dashboard", "permanent": false },
    { "source": "/dashboard/:path+", "destination": "/dashboard", "permanent": false }
  ],
  "crons": [{ "path": "/api/cron/anonymize-ips", "schedule": "0 3 * * *" }],
  "functions": { "api/dashboard-page.js": { "includeFiles": "dashboard/**" } }
}
